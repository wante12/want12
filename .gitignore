# Python 虚拟环境（每个约 66MB，绝对不要提交）
.venv/
venv/
env/

# Python 缓存
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# 密钥与本地配置
.env
config.ini
*.key

# Agent 练习的产出物（6MB 二进制，非代码）
Agent/Practice02/Mermaid.mmd
Agent/wAgent/Mermaid.mmd

# 宠物医院服务端
# 可执行文件随仓库分发（课程提供，便于克隆后直接运行），约 6.5 MB
# SHA256: 1CC99DB34E2CBB133897644BCAE298ABD53DFBE6315703601D1F57D9D988803E
# 运行时数据不入库（含业务数据，且每次运行都会变化）
PetHospitalServer/data/

# Node 依赖（bazi-mcp 约 34MB）
BaziMCP/node_modules/
package-lock.json

# MCP 本地配置（含本机端口/路径，因人而异）
.mcp.json

# Agent 运行时数据：会话、上下文归档、技能缓存
.agents/sessions/
.agents/context/

# 编辑器
.vscode/
.idea/

# 系统文件
Thumbs.db
.DS_Store
